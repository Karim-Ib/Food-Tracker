# ---- Postgres ----
# Superuser — used only by Postgres itself for admin operations.
# Never referenced by the API or dbt directly.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=replace_with_random_string

# Application user — used by the FastAPI service.
# Full control of the app schema, read-only on analytics.
APP_USER_PASSWORD=replace_with_random_string

# dbt user — used by dbt-core.
# Read-only on app schema, full control of analytics.
DBT_USER_PASSWORD=replace_with_random_string

# ---- Telegram ----
# Get from @BotFather. Use your DEV bot's token here; the production bot's token
# only ever lives in .env on the server.
TELEGRAM_BOT_TOKEN=

# ---- Gemini ----
# From Google AI Studio.
GEMINI_API_KEY=

# ---- Logging ----
# DEBUG for local dev, INFO for production.
LOG_LEVEL=DEBUG